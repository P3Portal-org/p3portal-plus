# p3portal.org
# P3 Portal Plus — environment variables example
#
# Copy to .env and adjust before first start.
#   cp .env.example .env

# Timezone for all containers (Portal, Celery-Worker, logs)
TZ=Europe/Berlin

# Backend
# Mandatory — generate with:
#   openssl rand -base64 32
# or
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-min-32-chars-random-string

# All other settings (Proxmox host, API tokens, admin account, etc.)
# are configured through the Setup Wizard on first start at
# https://<host>:8443.

# --- The variables below are optional. Uncomment if you prefer to
#     configure them via .env rather than the Setup Wizard. ---

# Proxmox
# PROXMOX_HOST=https://proxmox.example.com:8006
# PROXMOX_NODE=pve1
# PROXMOX_VERIFY_SSL=true

# Local admin account (skips Setup Wizard's admin step if both are set)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-before-first-start

# Proxmox API tokens (viewer / operator / admin)
# PROXMOX_VIEWER_TOKEN_ID=portal-viewer@pve!portal-viewer
# PROXMOX_VIEWER_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PROXMOX_OPERATOR_TOKEN_ID=portal-operator@pve!portal-operator
# PROXMOX_OPERATOR_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PROXMOX_ADMIN_TOKEN_ID=portal-admin@pve!portal-admin
# PROXMOX_ADMIN_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Packer API token (only needed for Image Factory / Packer builds)
# PACKER_TOKEN_ID=packer@pve!portal-packer
# PACKER_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PACKER_HTTP_IP=192.168.1.100

# Proxmox API audit log (optional)
# PROXMOX_AUDIT_ENABLED=1
# PROXMOX_AUDIT_LOG_BODY=1
# PROXMOX_AUDIT_DEBUG_USER=1

# Plus-Lizenz
# The plus.lic file goes into ./data/, not into .env.
# Either drop it in before start, or upload it later via
# System Settings → License or through the Setup Wizard.
